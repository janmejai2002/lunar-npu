{
  "name": "agent-craft",
  "version": "1.0.0",
  "description": "The Anti-Slop Visual Craft Linter, Perceptual Contrast Engine & MCP Server for AI Coding Agents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-craft": "./bin/agent-craft.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node ./bin/agent-craft.js",
    "test": "node --test tests/contrast.test.ts tests/detector.test.ts tests/fixer.test.ts tests/mcp.test.ts",
    "test:bun": "bun test",
    "lint": "node ./bin/agent-craft.js audit src/",
    "prepublishOnly": "tsc && node --test tests/contrast.test.ts tests/detector.test.ts tests/fixer.test.ts tests/mcp.test.ts"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janmejai2002/agent-craft.git"
  },
  "homepage": "https://github.com/janmejai2002/agent-craft#readme",
  "bugs": {
    "url": "https://github.com/janmejai2002/agent-craft/issues"
  },
  "keywords": [
    "ai",
    "mcp",
    "design-system",
    "linter",
    "anti-slop",
    "tailwind",
    "contrast",
    "wcag",
    "oklch",
    "cursor",
    "claude-code",
    "antigravity"
  ],
  "author": "Antigravity Open Source",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
